# --- PostgreSQL ---
POSTGRES_USER=invitations
POSTGRES_PASSWORD=changeme
POSTGRES_DB=invitations
POSTGRES_PORT=5434

# --- Backend ---
DATABASE_URL=postgresql://invitations:changeme@postgres:5432/invitations?schema=public
BACKEND_PORT=4000
JWT_SECRET=changeme-please-use-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
NODE_ENV=development

# Compte admin unique — utilisé uniquement par `npm run seed` (idempotent, upsert par email)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme-strong-password

# Storage driver: local (dev) | s3 (prod)
STORAGE_DRIVER=local
UPLOADS_DIR=/app/uploads

# Used by s3 driver when STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# Public base URL used to build shareable invitation links and OG image URLs
PUBLIC_BASE_URL=http://localhost:8080

# SMTP (mot de passe oublié). Laisser vide en dev : les emails sont journalisés dans les logs backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Invitations <no-reply@invitations.local>

# --- Frontend ---
VITE_API_BASE_URL=/api

# --- Nginx ---
NGINX_PORT=8080
