# Variables à renseigner dans Vercel : Project Settings → Environment Variables.
# Contrairement à .env.production.example (déploiement VPS via Docker), il n'y a ici ni
# domaine à pointer manuellement, ni certificat à gérer — Vercel s'en charge.

# --- Domaine ---
# L'URL exacte de ton déploiement Vercel (ou ton domaine personnalisé une fois branché).
# Doit correspondre EXACTEMENT (schéma https:// inclus, sans "/" final) : c'est ce qui
# autorise le cookie de session à fonctionner (CORS à origine unique).
PUBLIC_BASE_URL=https://ton-projet.vercel.app

# --- PostgreSQL (fournisseur externe : Vercel Postgres, Neon, Supabase...) ---
# DATABASE_URL = la connexion "pooled" (pgbouncer) fournie par ton hébergeur Postgres —
# obligatoire en environnement serverless (chaque requête peut ouvrir une connexion neuve).
DATABASE_URL=postgresql://user:password@host-pooler.region.provider.tech/dbname?sslmode=require&pgbouncer=true

# --- Backend ---
JWT_SECRET=changeme-secret-aleatoire-tres-long-64-caracteres-minimum
JWT_EXPIRES_IN=7d
COOKIE_SECURE=true
NODE_ENV=production

# Compte admin unique — utilisé seulement au moment du seed (voir DEPLOY_VERCEL.md).
ADMIN_EMAIL=admin@exemple.com
ADMIN_PASSWORD=changeme-mot-de-passe-fort

# --- Stockage des fichiers (photos/vidéos/musique) ---
# OBLIGATOIRE : "s3" sur Vercel. Le disque d'une fonction serverless est éphémère et en
# lecture seule (sauf /tmp, non persistant) — STORAGE_DRIVER=local ne fonctionnera jamais ici.
STORAGE_DRIVER=s3
S3_ENDPOINT=https://xxxxxxxx.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=invitations-media
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme
# URL publique de base pour lire les fichiers (bucket public, ou domaine CDN devant le bucket).
S3_PUBLIC_BASE_URL=https://media.ton-domaine.com
