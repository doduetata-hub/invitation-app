# MODÈLE (aucune valeur réelle) des variables à renseigner dans Vercel : Project Settings → Environment Variables.
# Ce fichier n'est lu par aucun programme. À adapter PAR PROJET : le projet de production et le projet de test
# n'ont PAS les mêmes variables. Voir DEPLOY_VERCEL.md (§3 garde-fou, §4 variables, §5 différences).
# Ne jamais copier ce fichier tel quel dans le projet de production : les blocs B et C ne doivent pas y figurer.
# Contrairement à .env.production.example (VPS via Docker), il n'y a ici ni domaine à pointer ni certificat à gérer.

# =====================================================================================================
# A. VARIABLES COMMUNES — production ET projet de test, avec des VALEURS DIFFÉRENTES dans chaque projet
# =====================================================================================================

# --- Domaine ---
# URL exacte du projet (https://, sans "/" final, sans chemin ni port) : c'est ce qui autorise le cookie de session
# (CORS à origine unique). En test, doit correspondre à "publicHost" de la cible dans staging-targets.json.
PUBLIC_BASE_URL=https://<domaine-du-projet>

# --- PostgreSQL (fournisseur externe : Vercel Postgres, Neon, Supabase...) ---
# DATABASE_URL = connexion "pooled" (pgbouncer) : obligatoire en serverless (chaque requête peut ouvrir une connexion
# neuve). Paramètres autorisés par le garde-fou : sslmode, channel_binding, pgbouncer=true, connection_limit,
# connect_timeout, pool_timeout, schema=public.
DATABASE_URL=postgresql://<utilisateur>:<mot-de-passe>@<hote-pooler>:<port>/<base>?sslmode=require&pgbouncer=true

# --- Backend ---
# JWT_SECRET : aléatoire, 32 caractères minimum, DIFFÉRENT entre production et test.
JWT_SECRET=<secret-aleatoire-long-propre-a-ce-projet>
JWT_EXPIRES_IN=7d
COOKIE_SECURE=true
# NODE_ENV est facultatif (l'installation frontend utilise « npm ci --omit=dev » et ne dépend plus de lui).
# NODE_ENV=production

# --- Stockage des fichiers (photos/vidéos/musique) ---
# OBLIGATOIRE : "s3" sur Vercel. Le disque d'une fonction serverless est éphémère : STORAGE_DRIVER=local ne
# fonctionnera jamais ici. Le bucket et le jeton d'accès sont PROPRES à chaque projet (le jeton du projet de test doit
# être limité au seul bucket de test).
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<identifiant-de-compte>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=<nom-du-bucket-de-ce-projet>
S3_ACCESS_KEY=<cle-d-acces-de-ce-projet>
S3_SECRET_KEY=<cle-secrete-de-ce-projet>
# URL publique de base (origine seule : https://hôte, sans chemin ni port) pour lire les fichiers.
S3_PUBLIC_BASE_URL=https://<domaine-public-des-medias>

# --- Facultatives ---
# FACE_FOCUS=off          # désactive la détection de visages (avatars du livre d'or)
# E-mail (réinitialisation du mot de passe admin) : PRODUCTION SEULEMENT. Interdit en test (voir bloc D).
# SMTP_HOST=<hote-smtp>
# SMTP_PORT=587
# SMTP_USER=<utilisateur-smtp>
# SMTP_PASSWORD=<mot-de-passe-smtp>
# SMTP_FROM=<expediteur>

# =====================================================================================================
# B. PROJET DE TEST UNIQUEMENT — obligatoires pour que le build passe les contrôles complets du garde-fou.
#    Interdits en production (le build de production serait refusé : E_TEST_CONFIG_ON_PRODUCTION).
#    Laissés en commentaire ici pour qu'une copie accidentelle ne les active pas.
# =====================================================================================================

# Connexion DIRECTE (sans "-pooler"). Nécessaire dans le projet de TEST (le garde-fou la compare à la cible).
# Ne pas la définir dans le projet de production.
# DIRECT_DATABASE_URL=postgresql://<utilisateur>:<mot-de-passe>@<hote-direct>:<port>/<base>?sslmode=require

# Autorisation de la cible : "ALLOW_MIGRATE_SEED_ON:" suivi de l'"id" de la cible dans backend/scripts/staging-targets.json.
# STAGING_DB_AUTHORIZATION=ALLOW_MIGRATE_SEED_ON:<id-de-la-cible>

# Liste noire OBLIGATOIRE des bases de PRODUCTION : hôtes (formes directe et poolée), "hôte" ou "hôte:port", séparés par des virgules.
# PRODUCTION_DB_HOSTS=<hote-direct-production>,<hote-pooler-production>

# Liste noire OBLIGATOIRE du stockage de PRODUCTION : au moins un "bucket:" ET un "public:" ; "endpoint:" seulement si
# le test utilise un autre compte Cloudflare que la production (l'endpoint R2 est propre au compte).
# PRODUCTION_R2_TARGETS=bucket:<nom-du-bucket-de-production>,public:<hote-public-medias-production>,public:<hote-du-site-de-production>

# Empreinte SHA-256 (64 caractères hexadécimaux) du JWT_SECRET de PRODUCTION, calculée HORS du dépôt (voir
# DEPLOY_VERCEL.md §8). Plusieurs empreintes possibles, séparées par des virgules.
# PRODUCTION_JWT_SHA256=<64-caracteres-hexadecimaux>

# =====================================================================================================
# C. OPÉRATIONS EXPLICITES (migrate, seed) — à définir dans le TERMINAL de l'opérateur, JAMAIS dans Vercel,
#    et seulement sur la base de TEST (voir DEPLOY_VERCEL.md §8). Le garde-fou refuse ces modes dans un build Vercel.
# =====================================================================================================
# STAGING_OP_AUTHORIZATION=ALLOW_MIGRATE_ON:<id-de-la-cible>   (ou ALLOW_SEED_ON:<id-de-la-cible> pour le seed)
# ADMIN_EMAIL=<adresse-admin-de-test>                          (seed seulement ; plus lu par le build)
# ADMIN_PASSWORD=<mot-de-passe-admin-de-test>                  (seed seulement ; ne jamais réutiliser celui de production)

# =====================================================================================================
# D. VARIABLES STRICTEMENT INTERDITES (ne pas les définir)
# =====================================================================================================
# En PRODUCTION : STAGING_DB_AUTHORIZATION, PRODUCTION_DB_HOSTS, PRODUCTION_R2_TARGETS, PRODUCTION_JWT_SHA256,
#                 STAGING_OP_AUTHORIZATION (variables de préproduction) ; toute variable VITE_* ; et jamais la base,
#                 le bucket, le jeton R2 ni le JWT_SECRET de préproduction.
# En TEST       : toute variable VITE_* (le frontend appelle /api sur la même origine, ne pas définir VITE_API_BASE_URL) ;
#                 SMTP_HOST (aucun vrai e-mail depuis le test) ; RESET_ADMIN_PASSWORD ; VERCEL_PROJECT_ID (variable
#                 système fournie par Vercel : ne jamais la définir à la main).
