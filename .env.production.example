# Copier vers .env.production sur le VPS et renseigner de vraies valeurs.
# Ce fichier ne doit JAMAIS être commité une fois rempli (déjà exclu via .gitignore).

# --- Domaine / HTTPS ---
# DOMAIN et PUBLIC_BASE_URL doivent correspondre au même nom de domaine (DNS déjà pointé ici).
DOMAIN=invitations.exemple.com
CERTBOT_EMAIL=contact@exemple.com
PUBLIC_BASE_URL=https://invitations.exemple.com

# --- PostgreSQL ---
POSTGRES_USER=invitations
POSTGRES_PASSWORD=changeme-mot-de-passe-fort-genere-aleatoirement
POSTGRES_DB=invitations

# --- Backend ---
DATABASE_URL=postgresql://invitations:changeme-mot-de-passe-fort-genere-aleatoirement@postgres:5432/invitations?schema=public
BACKEND_PORT=4000
JWT_SECRET=changeme-secret-aleatoire-tres-long-64-caracteres-minimum
JWT_EXPIRES_IN=7d
COOKIE_SECURE=true
NODE_ENV=production

# Compte admin unique — utilisé uniquement par `docker compose -f docker-compose.prod.yml exec backend npm run seed`
ADMIN_EMAIL=admin@exemple.com
ADMIN_PASSWORD=changeme-mot-de-passe-fort

# Storage driver: "local" (disque du VPS, volume Docker uploads_data — à inclure dans vos sauvegardes)
# ou "s3" (S3 / MinIO / tout stockage objet compatible S3). Les deux sont réellement implémentés.
STORAGE_DRIVER=local
UPLOADS_DIR=/app/uploads

# Utilisé uniquement si STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# URL publique servant les fichiers (CDN, domaine du bucket...). Si vide, construite depuis S3_ENDPOINT + S3_BUCKET.
S3_PUBLIC_BASE_URL=

# --- SMTP (mot de passe oublié) ---
# Si vide, les emails sont journalisés dans les logs backend au lieu d'être envoyés (utile en test,
# à éviter en production réelle : renseignez un vrai fournisseur SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Invitations <no-reply@votre-domaine.com>

# --- Frontend ---
VITE_API_BASE_URL=/api
